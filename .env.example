PORT=7860
TEAM_KEY=replace-with-a-long-random-secret
MAX_TEAM_SESSIONS=5
MAX_PUBLIC_SESSIONS=4
TEAM_TIMEOUT_MINUTES=480
PUBLIC_TIMEOUT_MINUTES=30
TEAM_IDLE_TIMEOUT_MINUTES=60
PUBLIC_IDLE_TIMEOUT_MINUTES=15
RECONNECT_GRACE_SECONDS=300
TIMEOUT_WARNING_SECONDS=120
MAX_UPLOAD_MB=10
# Set to 1 behind Render's reverse proxy; leave 0 for direct local access.
TRUST_PROXY=0
