# Copy to .env for local use or upload .env in Render's environment settings.
# Render-provided variables override these file defaults. Never commit a real key.
NODE_ENV=production
PORT=7860
TEAM_KEY=
# Private quest bundle key. Set from your private .env; never commit a real key.
QUEST_MASTER_KEY=
MAX_TEAM_SESSIONS=5
MAX_PUBLIC_SESSIONS=4
TEAM_TIMEOUT_MINUTES=480
PUBLIC_TIMEOUT_MINUTES=30
TEAM_IDLE_TIMEOUT_MINUTES=60
PUBLIC_IDLE_TIMEOUT_MINUTES=15
RECONNECT_GRACE_SECONDS=300
TIMEOUT_WARNING_SECONDS=120
MAX_UPLOAD_MB=10
SESSION_MAX_PROCESSES=256
SESSION_MAX_FILE_MB=512
# Set 1 on Render; set 0 when connecting directly without a reverse proxy.
TRUST_PROXY=0
CTF_UID=1001
CTF_GID=1001
DEMO_UID=1002
DEMO_GID=1002
# Blank selects the operating system's temporary workspace location.
BASE_SESSIONS_DIR=
ALLOW_WINDOWS_TEAM=false
