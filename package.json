{
  "name": "clite",
  "version": "2.0.0",
  "description": "CLI Lite: a lightweight browser-based Linux/CTF web shell with public demo and team modes.",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:python": "python -m unittest discover -s tests -p test_*.py"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
